# Neon Postgres connection string (pooled connection recommended)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Seed admin (used once by prisma/seed.ts to create the first مدير النظام)
SEED_ADMIN_NAME="مدير النظام"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Cloudinary (Phase 3 — product image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Required before deleting an invoice, customer, or payment
DELETE_CONFIRM_PASSWORD=""

# Optional — only needed if your Postgres client requires an unpooled
# connection (e.g. Prisma <5.10). Use your own project's unpooled URL here.
# DATABASE_URL_UNPOOLED=""